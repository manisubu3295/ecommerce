# Public Razorpay Checkout key. Never put the secret key in frontend code.
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key
VITE_RAZORPAY_CURRENCY=INR

# Client-side site URL used in SEO tags and JSON-LD. Set this once instead of
# editing siteConfig.js/index.html/robots.txt/sitemap.xml individually.
VITE_SITE_URL=https://baraniscouture.com

# PostgreSQL connection. Use a managed Postgres URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baraniscouture
# TLS to Postgres is on by default when NODE_ENV=production. Set to false if
# the database runs on the same machine without TLS.
# DATABASE_SSL=false

# PostgreSQL-backed admin session bootstrap. Change both before deployment.
ADMIN_EMAIL=admin@baraniscouture.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Use matching Razorpay Test Mode credentials for local testing.
RAZORPAY_KEY_ID=rzp_test_your_public_key
RAZORPAY_KEY_SECRET=replace-with-matching-test-secret
RAZORPAY_CURRENCY=INR
COURIER_WEBHOOK_SECRET=replace-with-courier-webhook-secret

# Server-side URL used in transactional email links (order tracking, etc.).
PUBLIC_SITE_URL=https://baraniscouture.com

# Only set this to true for LOCAL DEVELOPMENT without Razorpay keys, so
# checkout can be exercised without a payment gateway. Never set this in any
# environment reachable by real customers — it is ignored entirely when
# NODE_ENV=production, but don't rely on that alone.
ALLOW_DEMO_CHECKOUT=true

# Set NODE_ENV=production when deploying. Required for the Secure cookie flag,
# the ADMIN_EMAIL/ADMIN_PASSWORD requirement, and to permanently disable demo checkout.
NODE_ENV=development

# Set when running behind a reverse proxy / load balancer (Nginx, Render,
# Heroku, etc.) so rate limiting sees the real client IP instead of the
# proxy's. Leave unset for a bare `node server/index.js` on your own machine.
# TRUST_PROXY=true

# Optional: SMTP credentials for transactional email (order confirmations,
# shipping updates, return/refund decisions, contact form notifications).
# Emails are silently skipped if these are not set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Barani's Couture <orders@baraniscouture.com>"
